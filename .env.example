CORS_ORIGINS=http://localhost:8080
DATABASE_URL=postgresql://secureship:change-me@localhost:5432/secureship
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                  # set it and start Redis with --requirepass
MAX_UPLOAD_MB=25
MAX_UNZIPPED_MB=100
MAX_FILES=5000
MAX_QUEUE=50
SCAN_TIMEOUT_SEC=120
RATE_SCANS_PER_HOUR=10
RATE_SCANS_PER_HOUR_IP=30
RATE_READS_PER_MIN=240
MAX_ATTEMPTS=3                   # retries for a scan whose worker died
STUCK_AFTER_SEC=900
RETENTION_DAYS=30                # finished scans are deleted after this
MAINTENANCE_INTERVAL_SEC=300
DB_POOL_MAX=10
COOKIE_SECURE=false              # set true behind HTTPS
